APP_NAME="NextGen Apparel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://nextgenapparel.test

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local (Herd): SQLite, un archivo en database/database.sqlite; no hace falta
# ningún servidor de base de datos. En el servidor de OVH se usa MariaDB:
# DB_CONNECTION=mariadb y DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME, DB_PASSWORD.
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="pedidos@nextgenapparel.test"
MAIL_FROM_NAME="${APP_NAME}"

# Alertas de errores críticos (Herramientas → Log de errores).
# En local se escriben en storage/logs/laravel.log en vez de enviarse.
ALERTAS_EMAIL=
ALERTAS_CADA_MINUTOS=60

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Copias de seguridad (Herramientas → Copias de seguridad).
# Contraseña de cifrado de los ZIP: obligatoria en el servidor. Guárdala
# también fuera del servidor: sin ella no se pueden abrir las copias.
BACKUP_ARCHIVE_PASSWORD=
# Copia fuera del servidor (OVH Object Storage). Desactivada hasta contratarlo.
COPIAS_EXTERNAS_ACTIVAS=false
COPIAS_EXTERNAS_ENDPOINT=
COPIAS_EXTERNAS_REGION=gra
COPIAS_EXTERNAS_BUCKET=
COPIAS_EXTERNAS_KEY=
COPIAS_EXTERNAS_SECRET=

# Pagos (fase 7): "simulada" en local; en el servidor, "redsys" con los datos del TPV (nunca en GitHub).
PAGOS_PASARELA=simulada
REDSYS_MERCHANT_CODE=
REDSYS_TERMINAL=1
REDSYS_SECRET_KEY=
REDSYS_ENVIRONMENT=test
REDSYS_BIZUM=false

# Verificación en dos pasos del equipo en el panel (D186): obligatoria en el servidor.
DOS_PASOS_OBLIGATORIOS=false

# Asistente IA (v2, D194): OpenAI. Sin clave, el asistente no aparece. También se puede guardar cifrada en Ajustes → IA (D227); si está aquí, manda esta.
OPENAI_API_KEY=
