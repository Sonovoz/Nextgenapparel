# Entorno de produccion en el servidor de OVH.
# Copia este archivo a docker/env/produccion.env (no se sube al repositorio)
# y rellena las contraseñas. Genera APP_KEY con:
#   docker run --rm nextgenapparel/app:local php artisan key:generate --show

APP_NAME="NextGen Apparel"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://nextgenapparel.example
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=nextgenapparel
DB_USERNAME=nextgenapparel
DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="pedidos@nextgenapparel.example"
MAIL_FROM_NAME="${APP_NAME}"

ALERTAS_EMAIL=
ALERTAS_CADA_MINUTOS=60

# Obligatoria: sin ella las copias no se cifran. Guárdala también fuera del servidor.
BACKUP_ARCHIVE_PASSWORD=
COPIAS_EXTERNAS_ACTIVAS=false
COPIAS_EXTERNAS_ENDPOINT=
COPIAS_EXTERNAS_REGION=gra
COPIAS_EXTERNAS_BUCKET=
COPIAS_EXTERNAS_KEY=
COPIAS_EXTERNAS_SECRET=

# Solo para Docker: puerto local del servidor web (Caddy entra por la red «proxy»).
PUERTO_WEB=8080

# Pagos (fase 7): Redsys real. Los datos los da el banco; nunca en GitHub.
PAGOS_PASARELA=redsys
REDSYS_MERCHANT_CODE=
REDSYS_TERMINAL=1
REDSYS_SECRET_KEY=
REDSYS_ENVIRONMENT=live
REDSYS_BIZUM=false

# Verificación en dos pasos del equipo en el panel (D186): obligatoria en el servidor.
DOS_PASOS_OBLIGATORIOS=true
