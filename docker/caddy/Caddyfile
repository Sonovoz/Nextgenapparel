{
	email {$CORREO_SSL}
}

{$DOMINIO_PRODUCCION} {
	encode gzip
	# Solo HTTPS durante un año (auditoría final, M4).
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy nga-produccion-web:80
}

{$DOMINIO_PRUEBAS} {
	encode gzip
	# El entorno de pruebas no debe aparecer en Google.
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy nga-pruebas-web:80
}
