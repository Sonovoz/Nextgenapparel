<?xml version="1.0" encoding="UTF-8"?>
<!--
  Política de ImageMagick de NextGen Apparel (fase 4, revisión N3).
  - Recursos acotados: lo que no cabe en memoria va a la caché en disco y, si
    tampoco, la operación falla con un aviso al cliente (nunca agota la RAM del
    dedicado, que comparten producción, pruebas y MariaDB). El analizador fija
    además sus propios límites (AnalizadorPng::RECURSOS). Sin límite «time»: cuenta
    desde que arranca el proceso y PHP-FPM reutiliza sus procesos durante horas.
  - Sin los lectores con historial de fallos graves (ImageTragick y similares):
    la tienda solo lee PNG y escribe PNG/WebP, siempre con el formato forzado.
-->
<policymap>
  <policy domain="resource" name="memory" value="256MiB"/>
  <policy domain="resource" name="map" value="512MiB"/>
  <policy domain="resource" name="disk" value="4GiB"/>
  <policy domain="resource" name="width" value="16KP"/>
  <policy domain="resource" name="height" value="16KP"/>
  <policy domain="delegate" rights="none" pattern="*"/>
  <policy domain="path" rights="none" pattern="@*"/>
  <policy domain="coder" rights="none" pattern="{EPHEMERAL,URL,HTTPS,HTTP,FTP,MSL,MVG,TEXT,LABEL,PS,PS2,PS3,EPS,EPI,EPSF,EPSI,PDF,PDFA,XPS,SVG,MSVG,RSVG,SHOW,WIN,PLT,PCL,PWP,CAPTION,PANGO}"/>
</policymap>
